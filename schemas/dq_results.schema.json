{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fidu/schemas/dq_results.schema.json",
  "title": "Enterprise DQ Kit run output",
  "description": "Top-level shape of outputs/dq_results.json. Versioned via top-level schema_version (semver). Patch = additive, minor = new optional fields, major = breaking renames or removals.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "execution_mode",
    "run_id",
    "datasets",
    "trust_score_summary"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project": {"type": "string"},
    "execution_mode": {"enum": ["native", "tool"]},
    "config_path": {"type": "string"},
    "run_id": {"type": "string"},
    "engine": {"type": "string"},
    "tool": {"type": "string"},
    "duration_ms": {"type": "number", "minimum": 0},
    "validation_warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "datasets": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataset"}
    },
    "trust_score_summary": {"$ref": "#/$defs/trust_score_summary"},
    "drift_report": {"$ref": "#/$defs/drift_report"}
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "required": [
        "dataset",
        "total_rules",
        "passed_rules",
        "failed_rules",
        "skipped_rules",
        "errored_rules",
        "results"
      ],
      "additionalProperties": true,
      "properties": {
        "dataset": {"type": "string"},
        "source": {
          "type": "object",
          "additionalProperties": true
        },
        "status": {"enum": ["completed", "error"]},
        "error_message": {"type": "string"},
        "total_rules": {"type": "integer", "minimum": 0},
        "passed_rules": {"type": "integer", "minimum": 0},
        "failed_rules": {"type": "integer", "minimum": 0},
        "skipped_rules": {"type": "integer", "minimum": 0},
        "errored_rules": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "number", "minimum": 0},
        "columns_seen": {
          "type": "array",
          "items": {"type": "string"}
        },
        "results": {
          "type": "array",
          "items": {"$ref": "#/$defs/rule_result"}
        }
      }
    },
    "rule_result": {
      "type": "object",
      "required": [
        "rule_name",
        "rule_type",
        "dimension",
        "severity",
        "status"
      ],
      "additionalProperties": true,
      "properties": {
        "rule_name": {"type": "string"},
        "rule_type": {"type": "string"},
        "column": {"type": ["string", "null"]},
        "columns": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "dimension": {"type": "string"},
        "severity": {"enum": ["critical", "warning", "info"]},
        "status": {"enum": ["passed", "failed", "skipped", "error"]},
        "total_rows": {"type": ["integer", "null"], "minimum": 0},
        "failed_count": {"type": ["integer", "null"], "minimum": 0},
        "pass_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "duration_ms": {"type": "number", "minimum": 0},
        "details": {"type": "object", "additionalProperties": true},
        "failed_sample": {"type": "array", "items": {"type": "object"}},
        "error_message": {"type": "string"}
      }
    },
    "trust_score_summary": {
      "type": "object",
      "required": ["overall_trust_score", "overall_grade", "dataset_scores"],
      "additionalProperties": true,
      "properties": {
        "overall_trust_score": {"type": ["number", "null"]},
        "overall_grade": {"type": "string"},
        "grade_reason": {"type": "string"},
        "dataset_scores": {
          "type": "array",
          "items": {"$ref": "#/$defs/dataset_score"}
        }
      }
    },
    "dataset_score": {
      "type": "object",
      "required": ["dataset", "trust_score", "grade", "dimension_scores"],
      "additionalProperties": true,
      "properties": {
        "dataset": {"type": "string"},
        "trust_score": {"type": ["number", "null"]},
        "grade": {"type": "string"},
        "grade_reason": {"type": "string"},
        "critical_failures": {"type": "integer", "minimum": 0},
        "warning_failures": {"type": "integer", "minimum": 0},
        "skipped_rules": {"type": "integer", "minimum": 0},
        "errored_rules": {"type": "integer", "minimum": 0},
        "dimension_scores": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["score", "failed_rules", "total_rules"],
            "properties": {
              "score": {"type": ["number", "null"]},
              "failed_rules": {"type": "integer", "minimum": 0},
              "total_rules": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "drift_report": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": true,
      "properties": {
        "status": {"type": "string"},
        "alert_count": {"type": "integer", "minimum": 0},
        "alerts": {"type": "array", "items": {"type": "object"}},
        "previous_run_timestamp": {"type": "string"},
        "current_run_timestamp": {"type": "string"},
        "history_warnings": {"type": "array"}
      }
    }
  }
}
